# ==============================================================================
# Environment Configuration Template
# Copy this file to .env.local and populate with your own credentials & IDs.
# .env.local is ignored by Git and will never be committed.
# ==============================================================================

# 1. Monarch Money Credentials
MONARCH_EMAIL="your-email@example.com"
MONARCH_PASSWORD="your-monarch-password"
MONARCH_MFA_SECRET="NONE"  # Base32 TOTP secret string if 2FA is enabled

# 2. Google Chat Space / Slack Webhook (For Proactive Daily Advisories)
ALERT_WEBHOOK_URL="https://chat.googleapis.com/v1/spaces/.../messages?key=...&token=..."

# 3. Google Cloud Platform Infrastructure
PROJECT_ID="your-gcp-project-id"
REGION="us-central1"
SERVICE_NAME="monarch-gemini-wrapper"
SERVICE_URL="https://your-cloud-run-service.run.app"
BQ_DATASET_ID="family_finance"

# 4. Optional API Security & Keys
# X-API-Key protecting webhook/sync endpoints (leave empty to generate one during setup)
# GEMINI_WRAPPER_KEY="your-random-api-key"
# Optional direct Gemini API Key (defaults to Vertex AI ADC if omitted)
# GEMINI_API_KEY="your-gemini-api-key"

# 5. Account Customization & Overrides
# Override account attributes such as variable APRs (e.g. HELOCs, loans, mortgages)
# Format: JSON string mapping account_id -> { "interest_rate": float }
# ACCOUNT_OVERRIDES_JSON='{"123456789012345678": {"interest_rate": 0.0675}}'

# Comma-separated list or JSON array of Monarch Account IDs to exclude from sync
# DECOMMISSIONED_ACCOUNT_IDS="123456789012345678,987654321098765432"

# Comma-separated list of institution name keywords to exclude
# EXCLUDED_INSTITUTIONS="defunct_bank,legacy_credit_union"
