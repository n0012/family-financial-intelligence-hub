#!/bin/sh
# Last local gate: rescan every commit about to be pushed (catches commits made with --no-verify).
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    base="$(git merge-base origin/main "$local_sha" 2>/dev/null || git rev-list --max-parents=0 "$local_sha" | tail -1)"
  else
    base="$remote_sha"
  fi
  python3 "$root/scripts/check_private_data.py" --range "$base..$local_sha" || exit 1
  for c in $(git rev-list "$base..$local_sha"); do
    git log -1 --format=%B "$c" > "$root/.git/PUSH_MSG_CHECK"
    python3 "$root/scripts/check_private_data.py" --message-file "$root/.git/PUSH_MSG_CHECK" || { echo "  (in commit $c)"; exit 1; }
  done
done
