    "/transactions/create": {
      "post": {
        "operationId": "createTransaction",
        "summary": "Create a manual transaction",
        "description": "Records a new manual transaction in Monarch Money under a specified account.",
        "x-openai-isConsequential": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "date",
                  "account_id",
                  "amount",
                  "merchant_name",
                  "category_id"
                ],
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date",
                    "description": "Transaction date in YYYY-MM-DD format."
                  },
                  "account_id": {
                    "type": "string",
                    "description": "Monarch account ID to record transaction under."
                  },
                  "amount": {
                    "type": "number",
                    "description": "Transaction amount (negative for expense, positive for income)."
                  },
                  "merchant_name": {
                    "type": "string",
                    "description": "Merchant or payee name."
                  },
                  "category_id": {
                    "type": "string",
                    "description": "Category ID to assign."
                  },
                  "notes": {
                    "type": "string",
                    "description": "Optional transaction notes."
                  },
                  "update_balance": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether to adjust manual account balance."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created transaction object.",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "default": {
            "": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/transactions/{transaction_id}/update": {
      "patch": {
        "operationId": "updateTransaction",
        "summary": "Update an existing transaction",
        "description": "Updates categorization, merchant name, notes, or review status of an existing transaction.",
        "x-openai-isConsequential": true,
        "parameters": [
          {
            "": "#/components/parameters/TransactionIdPath"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "category_id": {
                    "type": "string",
                    "description": "New category ID."
                  },
                  "merchant_name": {
                    "type": "string",
                    "description": "Updated merchant or payee name."
                  },
                  "notes": {
                    "type": "string",
                    "description": "Updated user notes."
                  },
                  "needs_review": {
                    "type": "boolean",
                    "description": "Mark as needing review."
                  },
                  "reviewed": {
                    "type": "boolean",
                    "description": "Mark as reviewed."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated transaction object.",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "default": {
            "": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/budgets/set-amount": {
      "post": {
