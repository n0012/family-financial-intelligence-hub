{
  "openapi": "3.1.0",
  "info": {
    "title": "Monarch Money API",
    "version": "1.0.0",
    "description": "OpenAPI 3.1 specification for Monarch Money API wrapper services. Enables assistants and automation workflows to securely query account balances, search and analyze transactions, inspect budget envelopes, track cashflow, and manage financial data based on the hammem/monarchmoney library."
  },
  "externalDocs": {
    "description": "Source Python library",
    "url": "https://github.com/hammem/monarchmoney"
  },
  "servers": [
    {
      "url": "https://YOUR-MONARCH-WRAPPER-URL.example.com",
      "description": "Replace with your deployed HTTPS Monarch Money wrapper service base URL"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Check wrapper health",
        "description": "Returns whether the wrapper service is running and can initialize the Monarch client.",
        "x-openai-isConsequential": false,
        "responses": {
          "200": {
            "description": "Wrapper health status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/accounts": {
      "get": {
        "operationId": "getAccounts",
        "summary": "List Monarch accounts",
        "description": "Gets all accounts linked to Monarch Money, including balances, account types, institutions, and account visibility fields.",
        "x-openai-isConsequential": false,
        "responses": {
          "200": {
            "description": "Accounts and household preferences returned by Monarch.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/account-type-options": {
      "get": {
        "operationId": "getAccountTypeOptions",
        "summary": "List account type options",
        "description": "Returns Monarch account types and subtypes available when creating or classifying accounts.",
        "x-openai-isConsequential": false,
        "responses": {
          "200": {
            "description": "Available account type and subtype options.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/accounts/recent-balances": {
      "get": {
        "operationId": "getRecentAccountBalances",
        "summary": "Get recent balances for all accounts",
        "description": "Retrieves daily recent balance series for all accounts starting at start_date. If omitted, the wrapper should use the library default of roughly the last 31 days.",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "$ref": "#/components/parameters/StartDateOptional"
          }
        ],
        "responses": {
          "200": {
            "description": "Recent balance series by account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/accounts/snapshots-by-type": {
      "get": {
        "operationId": "getAccountSnapshotsByType",
        "summary": "Get account snapshots grouped by type",
        "description": "Retrieves net-value snapshots grouped by account type with monthly or yearly granularity.",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": true,
            "description": "Start date for snapshots, in YYYY-MM-DD format.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "timeframe",
            "in": "query",
            "required": true,
            "description": "Snapshot granularity. The Python library accepts month or year.",
            "schema": {
              "type": "string",
              "enum": [
                "month",
                "year"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshots grouped by account type.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/accounts/aggregate-snapshots": {
      "get": {
        "operationId": "getAggregateSnapshots",
        "summary": "Get aggregate net-worth snapshots",
        "description": "Retrieves daily aggregate net value across accounts, optionally filtered by date range and account type.",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "$ref": "#/components/parameters/StartDateOptional"
          },
          {
            "$ref": "#/components/parameters/EndDateOptional"
          },
          {
            "name": "account_type",
            "in": "query",
            "required": false,
            "description": "Optional Monarch account type filter, for example checking, credit_card, brokerage, loan, other_asset, or other_liability.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Aggregate snapshot time series.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/accounts/{account_id}/holdings": {
      "get": {
        "operationId": "getAccountHoldings",
        "summary": "Get holdings for an investment account",
        "description": "Gets securities and holdings information for a brokerage or similar account.",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountIdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Account holdings and security details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/accounts/{account_id}/history": {
      "get": {
        "operationId": "getAccountHistory",
        "summary": "Get account balance history",
        "description": "Gets historical daily balance snapshots for one account.",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountIdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Historical account balance snapshots.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/JsonObject"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/JsonObject"
                      }
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/institutions": {
      "get": {
        "operationId": "getInstitutions",
