                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/budgets": {
      "get": {
        "operationId": "getBudgets",
        "summary": "Get budgets and actuals",
        "description": "Gets budgets, category groups, monthly amounts, actual amounts, and related goal data. Provide both start_date and end_date, or omit both to use the wrapper/library defaults.",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "$ref": "#/components/parameters/StartDateOptional"
          },
          {
            "$ref": "#/components/parameters/EndDateOptional"
          }
        ],
        "responses": {
          "200": {
            "description": "Budget data and category groups.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/subscription": {
      "get": {
        "operationId": "getSubscriptionDetails",
        "summary": "Get Monarch subscription details",
        "description": "Gets subscription status, payment source, referral code, trial status, and premium entitlement fields returned by Monarch.",
        "x-openai-isConsequential": false,
        "responses": {
          "200": {
            "description": "Subscription details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/transactions/summary": {
      "get": {
        "operationId": "getTransactionsSummary",
        "summary": "Get transaction summary aggregates",
        "description": "Gets transaction summary aggregates from Monarch, such as count, average, sum, income, expense, first, and last transaction dates.",
        "x-openai-isConsequential": false,
        "responses": {
          "200": {
            "description": "Transaction summary aggregates.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/transactions": {
      "get": {
        "operationId": "getTransactions",
        "summary": "Search and list transactions",
        "description": "Lists Monarch transactions with optional filters for date range, search text, accounts, categories, tags, attachments, notes, hidden status, split status, recurring status, Mint import status, and institution-sync status.",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of transactions to return. The library default is 100.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Number of transactions to skip before returning results.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "$ref": "#/components/parameters/StartDateOptional"
          },
          {
            "$ref": "#/components/parameters/EndDateOptional"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Search text to match transactions, merchants, notes, or descriptions, depending on Monarch behavior.",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "category_ids",
            "in": "query",
            "required": false,
            "description": "Comma-separated Monarch category IDs to filter by.",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "account_ids",
            "in": "query",
            "required": false,
            "description": "Comma-separated Monarch account IDs to filter by.",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "tag_ids",
            "in": "query",
            "required": false,
            "description": "Comma-separated Monarch tag IDs to filter by.",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "has_attachments",
            "in": "query",
            "required": false,
            "description": "Filter for transactions that have or do not have attachments.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "has_notes",
            "in": "query",
            "required": false,
            "description": "Filter for transactions that have or do not have notes.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "hidden_from_reports",
            "in": "query",
            "required": false,
            "description": "Filter by whether transactions are hidden from reports.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "is_split",
            "in": "query",
            "required": false,
            "description": "Filter by whether transactions are split transactions.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "is_recurring",
            "in": "query",
            "required": false,
            "description": "Filter by whether transactions are recurring.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "imported_from_mint",
            "in": "query",
            "required": false,
            "description": "Filter by whether transactions were imported from Mint.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "synced_from_institution",
            "in": "query",
            "required": false,
            "description": "Filter by whether transactions were synced from a financial institution.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction list and total count.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/transactions/{transaction_id}": {
      "get": {
        "operationId": "getTransactionDetails",
        "summary": "Get transaction details",
        "description": "Gets detailed information about one transaction, including category, merchant, account, tags, attachments, split/original transaction information, and review fields.",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "$ref": "#/components/parameters/TransactionIdPath"
          },
          {
            "name": "redirect_posted",
            "in": "query",
            "required": false,
            "description": "Whether Monarch should redirect a pending transaction to a posted transaction when applicable.",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detailed transaction data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
